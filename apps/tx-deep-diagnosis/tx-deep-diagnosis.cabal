cabal-version: 3.0
name:          tx-deep-diagnosis
version:       0.1.0.0
synopsis:      Layered Conway tx diagnosis using cardano-ledger-conway via the cardano-ledger-inspector library
author:        lambdasistemi
license:       Apache-2.0
build-type:    Simple

-- The protocol registry travels with the binary so 'nix run' from
-- anywhere finds the script-hash labels without needing a local
-- checkout. Resolved at runtime via Paths_tx_deep_diagnosis.getDataDir.
data-dir:      ../../docs/inspector/protocols
data-files:
    registry.json
    amaru-treasury/journal-2026.json
    amaru-treasury/pin.json
    sundaeswap-v3/plutus.json
    sundaeswap-v3/pin.json
    sundaeswap-treasury-v3/plutus.json
    sundaeswap-treasury-v3/pin.json

library
  hs-source-dirs:   src
  exposed-modules:
    TxDeepDiagnosisHost.Blockfrost
    TxDeepDiagnosisHost.Diagnosis
    TxDeepDiagnosisHost.Registry
    TxDeepDiagnosisHost.Render.Doc
    TxDeepDiagnosisHost.Render.Failures
    TxDeepDiagnosisHost.Render.Names
    TxDeepDiagnosisHost.Render.Parties
    TxDeepDiagnosisHost.Render.Summary
    TxDeepDiagnosisHost.Render.Topology
    TxDeepDiagnosisHost.Render.ValueFlow
    TxDeepDiagnosisHost.Report

  build-depends:
    , aeson                 >=2.0
    , aeson-pretty
    , base                  >=4.18 && <5
    , base16-bytestring
    , bech32                >=1.1
    , bytestring
    , containers
    , directory
    , filepath
    , http-client
    , http-client-tls
    , http-types
    , scientific
    , text
    , vector
    , cardano-ledger-inspector

  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-imports

executable tx-deep-diagnosis
  main-is:          Main.hs
  hs-source-dirs:   app
  other-modules:    Paths_tx_deep_diagnosis
  autogen-modules:  Paths_tx_deep_diagnosis
  build-depends:
    , aeson
    , base                  >=4.18 && <5
    , bytestring
    , containers
    , http-client
    , http-client-tls
    , optparse-applicative
    , text
    , tx-deep-diagnosis
    , cardano-ledger-inspector

  default-language: Haskell2010
  ghc-options:      -Wall

executable tx-deep-diagnosis-render-snapshot
  main-is:          Main.hs
  hs-source-dirs:   snapshot
  other-modules:    Paths_tx_deep_diagnosis
  autogen-modules:  Paths_tx_deep_diagnosis
  build-depends:
    , aeson
    , base                  >=4.18 && <5
    , bytestring
    , directory
    , filepath
    , text
    , tx-deep-diagnosis

  default-language: Haskell2010
  ghc-options:      -Wall
