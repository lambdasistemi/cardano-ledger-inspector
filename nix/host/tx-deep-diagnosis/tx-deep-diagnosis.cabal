cabal-version: 3.0
name:          tx-deep-diagnosis
version:       0.1.0.0
synopsis:      Layered diagnosis of a Conway transaction via Blockfrost + Plutus blueprints
author:        lambdasistemi
license:       Apache-2.0
build-type:    Simple

library
  hs-source-dirs:   src
  exposed-modules:
    TxDeepDiagnosis.Blockfrost
    TxDeepDiagnosis.Conway
    TxDeepDiagnosis.Diagnosis
    TxDeepDiagnosis.Registry
    TxDeepDiagnosis.Report
    TxDeepDiagnosis.Types

  build-depends:
    , aeson                 >=2.0
    , base                  >=4.17 && <5
    , base16-bytestring
    , bytestring
    , cborg                 >=0.2
    , containers
    , directory
    , filepath
    , http-client
    , http-client-tls
    , http-types
    , scientific
    , text

  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-imports

executable tx-deep-diagnosis
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , aeson
    , base                  >=4.17 && <5
    , base16-bytestring
    , bytestring
    , http-client
    , http-client-tls
    , optparse-applicative
    , text
    , tx-deep-diagnosis

  default-language: Haskell2010
  ghc-options:      -Wall -Wno-name-shadowing -Wno-unused-imports
