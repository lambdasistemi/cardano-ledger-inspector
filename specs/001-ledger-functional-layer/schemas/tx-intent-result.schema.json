{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lambdasistemi.github.io/cardano-ledger-inspector/schemas/tx-intent-result.schema.json",
  "title": "Cardano Ledger WASI Transaction Intent Result",
  "type": "object",
  "required": ["title", "subtitle", "metrics", "claims", "sections", "withdrawals", "warnings"],
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "tx_id": { "type": "string" },
    "body_hash": { "type": "string" },
    "fee_lovelace": { "type": "string" },
    "input_policy": { "type": "string" },
    "metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/metric" }
    },
    "claims": {
      "type": "array",
      "description": "Human-readable metadata claims extracted from transaction auxiliary metadata. These are self-declared claims, not independently verified facts.",
      "items": { "$ref": "#/$defs/claim" }
    },
    "metadata_claims": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "signing": {
      "type": "object",
      "additionalProperties": true
    },
    "value": {
      "type": "object",
      "properties": {
        "net_spend_known": { "type": "boolean" },
        "net_spend_note": { "type": "string" },
        "signer_lovelace": {
          "type": "object",
          "properties": {
            "known": { "type": "boolean" },
            "resolved_input_lovelace": { "type": "string" },
            "output_lovelace": { "type": "string" },
            "external_or_script_output_lovelace": { "type": "string" },
            "net_lovelace": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "basis": { "type": "string" }
          },
          "additionalProperties": true
        },
        "resolved_input_buckets": {
          "type": "array",
          "items": { "$ref": "#/$defs/valueBucket" }
        },
        "output_buckets": {
          "type": "array",
          "items": { "$ref": "#/$defs/valueBucket" }
        }
      },
      "additionalProperties": true
    },
    "features": {
      "type": "object",
      "additionalProperties": true
    },
    "effects": {
      "type": "array",
      "items": { "$ref": "#/$defs/effect" }
    },
    "withdrawals": {
      "type": "array",
      "items": { "$ref": "#/$defs/withdrawal" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": ["label", "value", "detail"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "required": ["label", "value", "detail"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": true
    },
    "section": {
      "type": "object",
      "required": ["title", "empty", "rows"],
      "properties": {
        "title": { "type": "string" },
        "empty": { "type": "string" },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/row" }
        }
      },
      "additionalProperties": true
    },
    "row": {
      "type": "object",
      "required": ["label", "value", "path", "copyValue", "detail"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "path": { "type": "string" },
        "copyValue": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": true
    },
    "credential": {
      "type": "object",
      "required": ["kind", "hash"],
      "properties": {
        "kind": { "type": "string", "enum": ["key", "script"] },
        "hash": { "type": "string" }
      },
      "additionalProperties": true
    },
    "withdrawal": {
      "type": "object",
      "required": ["index", "reward_account_hex", "network", "credential", "amount_lovelace"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "reward_account_hex": { "type": "string" },
        "network": { "type": "string", "enum": ["mainnet", "testnet"] },
        "credential": { "$ref": "#/$defs/credential" },
        "amount_lovelace": { "type": "string" }
      },
      "additionalProperties": true
    },
    "valueBucket": {
      "type": "object",
      "required": ["bucket", "label", "tx_out_count", "lovelace", "asset_class_count"],
      "properties": {
        "bucket": {
          "type": "string",
          "enum": ["signer_controlled", "external_key", "script", "bootstrap"]
        },
        "label": { "type": "string" },
        "tx_out_count": { "type": "integer", "minimum": 0 },
        "lovelace": { "type": "string" },
        "asset_class_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
