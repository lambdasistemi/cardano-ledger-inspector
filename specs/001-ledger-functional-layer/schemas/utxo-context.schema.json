{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lambdasistemi.github.io/cardano-ledger-wasi/schemas/utxo-context.schema.json",
  "title": "Cardano Ledger WASI UTxO Context",
  "type": "object",
  "properties": {
    "utxo": {
      "type": "object",
      "description": "Resolved immutable transaction outputs keyed as '<tx_id>#<index>'.",
      "propertyNames": {
        "pattern": "^[0-9a-f]{64}#[0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/resolvedUtxo"
      }
    },
    "resolution": {
      "type": "object",
      "description": "Host/provider metadata describing how the UTxO context was resolved.",
      "properties": {
        "provider": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "requested_input_count": {
          "$ref": "#/$defs/count"
        },
        "requested_reference_input_count": {
          "$ref": "#/$defs/count"
        },
        "resolved_count": {
          "$ref": "#/$defs/count"
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}#[0-9]+$"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unspent_status": {
          "type": "string",
          "enum": ["not_checked", "checked"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "resolvedUtxo": {
      "type": "object",
      "required": ["tx_id", "index", "address", "source"],
      "properties": {
        "tx_id": {
          "$ref": "#/$defs/hash32"
        },
        "index": {
          "$ref": "#/$defs/count"
        },
        "address": {
          "type": "string"
        },
        "lovelace": {
          "type": "string",
          "pattern": "^[0-9]*$"
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        },
        "datum_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash32"
            },
            {
              "type": "null"
            }
          ]
        },
        "inline_datum_cbor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_script_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{56}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "unspent_status": {
          "type": "string",
          "enum": ["not_checked", "checked"]
        }
      },
      "additionalProperties": true
    },
    "hash32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
