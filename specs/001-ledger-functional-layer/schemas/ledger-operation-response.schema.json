{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lambdasistemi.github.io/cardano-ledger-inspector/schemas/ledger-operation-response.schema.json",
  "title": "Cardano Ledger WASI Ledger Operation Response",
  "type": "object",
  "required": ["ledger_functional_layer", "op", "result"],
  "properties": {
    "ledger_functional_layer": {
      "type": "string",
      "const": "cardano-ledger-functional/v1"
    },
    "op": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "result": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "enum": ["tx.rdf", "tx.graph"]
          }
        },
        "required": ["op"]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "tx-rdf-result.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "enum": ["tx.review"]
          }
        },
        "required": ["op"]
      },
      "then": {
        "properties": {
          "result": {
            "required": ["review"],
            "properties": {
              "review": {
                "$ref": "tx-review-result.schema.json"
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
