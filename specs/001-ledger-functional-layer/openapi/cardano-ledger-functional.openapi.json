      "name": "Apache-2.0",
      "url": "https://github.com/lambdasistemi/cardano-ledger-inspector/blob/main/LICENSE"
    },
    "summary": "Functional ledger-operation boundary for Cardano transaction tooling.",
    "title": "Cardano Ledger WASI Functional API",
    "version": "0.1.0-draft"
  },
  "openapi": "3.1.0",
