cabal-version: 3.0
name:          cardano-ledger-inspector
version:       0.1.0.0
synopsis:      Conway tx inspector built on the Haskell ledger code; compiles natively or to wasm32-wasi
author:        lambdasistemi
license:       Apache-2.0
build-type:    Simple

executable wasm-tx-inspector
  main-is:          Main.hs
  hs-source-dirs:   app
  other-modules:    Conway.Inspector.ProtocolRegistry
                  , Conway.Inspector.EmbeddedRegistry
  build-depends:    base                  >=4.19 && <5
                  , aeson
                  , base16-bytestring
                  , bytestring
                  , text
                  , containers
                  , cardano-crypto-class
                  , cardano-ledger-api
                  , cardano-ledger-binary
                  , cardano-ledger-conway
                  , cardano-ledger-core
                  , cardano-ledger-wasm
                  , microlens
                  , tx-rdf-core
  default-language: Haskell2010
  ghc-options:      -Wall
