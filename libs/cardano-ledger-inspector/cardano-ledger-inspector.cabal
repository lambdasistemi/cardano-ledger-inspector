cabal-version: 3.0
name:          cardano-ledger-inspector
version:       0.1.0.0
synopsis:      Conway tx inspector built on the Haskell ledger code; compiles natively or to wasm32-wasi
author:        lambdasistemi
license:       Apache-2.0
build-type:    Simple

library
  exposed-modules:
    Conway.Inspector

  other-modules:
    Conway.Inspector.ProtocolRegistry
    Conway.Inspector.EmbeddedRegistry

  hs-source-dirs:   src
  build-depends:    base                  >=4.19 && <5
                  , aeson
                  , base16-bytestring
                  , bytestring
                  , text
                  , containers
                  , cardano-crypto-class  >=2.3.2
                  , cardano-ledger-alonzo >=1.15
                  , cardano-ledger-api    >=1.13
                  , cardano-ledger-binary >=1.8.1
                  , cardano-ledger-conway >=1.22
                  , cardano-ledger-core   >=1.20
                  , cardano-ledger-wasm
                  , microlens
                  , plutus-ledger-api     >=1.61
  default-language: Haskell2010
  ghc-options:      -Wall

executable wasm-tx-inspector
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base                  >=4.19 && <5
                  , aeson
                  , base16-bytestring
                  , bytestring
                  , text
                  , containers
                  , cardano-crypto-class
                  , cardano-ledger-api
                  , cardano-ledger-conway
                  , cardano-ledger-core
                  , cardano-ledger-inspector
                  , microlens
  if impl(ghc >= 9.12)
    build-depends: tx-rdf-core
  else
    buildable: False
  default-language: Haskell2010
  ghc-options:      -Wall

executable tx-inspector-native
  main-is:          Main.hs
  hs-source-dirs:   native
  build-depends:    base                  >=4.18 && <5
                  , aeson
                  , bytestring
                  , cardano-ledger-inspector
                  , text
  default-language: Haskell2010
  ghc-options:      -Wall
